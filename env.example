# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=facility_erp
DB_PORT=5432

# Backend Configuration
NODE_ENV=production
BACKEND_PORT=3000

# JWT Configuration (REQUIRED - Generate strong secrets)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Session Secret (REQUIRED - Generate strong secret)
SESSION_SECRET=your_super_secret_session_key_min_32_chars

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:80,http://localhost:8080,https://yourdomain.com

# Email Configuration (AWS SES)
# Provider: Amazon Simple Email Service (SES)
# Region: ap-south-1
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=no-reply-dev@helixsense.com
AWS_SES_FROM_NAME=Helixsense

# OIDC Configuration (Optional - for Azure AD, Okta, etc.)
OIDC_AZURE_AD_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_AZURE_AD_CLIENT_ID=your_azure_client_id
OIDC_AZURE_AD_CLIENT_SECRET=your_azure_client_secret
OIDC_AZURE_AD_REDIRECT_URI=https://yourdomain.com/api/v1/auth/oauth2/azure_ad/callback

# Frontend Port
FRONTEND_PORT=80

# Frontend URL (REQUIRED for email templates with login links)
# This is the base URL where your frontend application is hosted
# Examples:
#   - Development: http://localhost:80
#   - Production: https://yourdomain.com
#   - Production: https://hsense-test-v1.helixsense.com
FRONTEND_URL=https://hsense-test-v1.helixsense.com

# Frontend API Configuration (REQUIRED for production)
# This is the API endpoint that the Flutter web app will use
# Examples:
#   - Same server (Docker network): http://backend:3000/api/v1
#   - External API: https://api.yourdomain.com/api/v1
#   - Same domain: https://yourdomain.com/api/v1
#   - Production: https://hsense-test-v1.helixsense.com/api/v1
API_BASE_URL=https://hsense-test-v1.helixsense.com/api/v1

# Firebase Configuration (for Push Notifications - REQUIRED)
# These values come from Firebase Service Account JSON file
# To get these values:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key" and download the JSON file
# 3. Extract the following values from the JSON:
#    - project_id -> FIREBASE_PROJECT_ID
#    - private_key -> FIREBASE_PRIVATE_KEY (keep the newlines as \n)
#    - client_email -> FIREBASE_CLIENT_EMAIL
#
# IMPORTANT: The private key must include escaped newlines (\n)
# Example: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Gemini AI API Key (OPTIONAL - for AI ticket analysis feature)
# Get your key from: https://makersuite.google.com/app/apikey
# If not provided, the AI analysis feature will be disabled
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Provider Configuration
# Storage Provider: 'local' or 's3' (default: 'local')
# - 'local': Store files in ./uploads directory on the server
# - 's3': Store files in AWS S3 bucket
STORAGE_PROVIDER=local

# Local Storage Configuration (used when STORAGE_PROVIDER=local)
UPLOADS_DIR=uploads
UPLOADS_BASE_URL=/api/uploads

# AWS S3 Configuration (only needed if STORAGE_PROVIDER=s3)
AWS_S3_ACCESS_KEY_ID=your_aws_s3_access_key_id
AWS_S3_SECRET_ACCESS_KEY=your_aws_s3_secret_access_key
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=user1-bucket-test
AWS_S3_BASE_PREFIX=tenx-attachments

# Escalation Scheduler Configuration
# Interval in minutes for checking ticket escalations (default: 1, range: 1-60)
ESCALATION_CHECK_INTERVAL_MINUTES=1

